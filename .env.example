# Environment variables — Port Operations Intelligence Platform
# Copy to .env (development) or set in your deployment's secret store.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ── Core ────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
# SQLite file. In Docker this is /data/portops.db on a persistent volume.

AUTH_SECRET="change-me-in-production"
# Signs session cookies. REQUIRED in production: random, 32+ characters.
# The server refuses to start in production with a missing/placeholder value.
# (DEMO_AUTH_SECRET is still accepted as a legacy name.)

DATA_ENCRYPTION_KEY=""
# Optional but recommended: encrypts secrets stored in the database (MFA seeds).
# When unset, a key is derived from AUTH_SECRET — then rotating AUTH_SECRET
# requires users to re-enroll their authenticator app.

APP_NAME="Port Operations Intelligence"
APP_BASE_URL="http://localhost:3000"
# Public URL of the app (used for the SSO redirect URI).

# APP_ALLOWED_ORIGINS="https://ops.example.com"
# Extra origins allowed to POST to the API (comma-separated). Same-origin is
# always allowed; everything else is rejected as cross-site.

# ── Sign-in policy ──────────────────────────────────────────────────────
SESSION_TTL_HOURS=8
MFA_REQUIRED_ROLES="administrator"
# Comma-separated roles that must enroll an authenticator app (password
# sign-in). Empty = MFA optional for everyone. SSO users get MFA from the IdP.
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

# ── Single sign-on (OpenID Connect) — optional ──────────────────────────
# OIDC_ISSUER="https://login.example.com/realms/port"
# OIDC_CLIENT_ID="port-ops"
# OIDC_CLIENT_SECRET=""
# OIDC_PROVIDER_NAME="Port SSO"
# OIDC_ROLE_CLAIM="realm_access.roles"       # dot path to groups/roles claim
# OIDC_ROLE_MAP='{"port-ops-admins":"administrator","port-ops-supervisors":"supervisor","port-ops-planners":"planner","port-ops-operators":"operations_operator","port-ops-viewers":"operations_viewer"}'
# OIDC_DEFAULT_ROLE=""                       # unset = deny users with no mapped group
# Register redirect URI: ${APP_BASE_URL}/api/auth/oidc/callback

# ── Operations ──────────────────────────────────────────────────────────
# METRICS_TOKEN=""
# Bearer token for GET /api/metrics (Prometheus). Unset = metrics disabled.
# BACKUP_DIR="./backups"
# BACKUP_KEEP=14

# ── Demo data (development / sales demos) ───────────────────────────────
# SEED_PASSWORD=""
# Password for the five demo accounts created by `npm run db:seed`.
# Unset in development = a random password is generated and printed once.
# Required when seeding with NODE_ENV=production.
