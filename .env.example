# Environment variables — Port Operations Intelligence Platform (DEMO)

DATABASE_URL="file:./dev.db"
# SQLite file path. For the demo MVP this is a local file. No server needed.

DEMO_AUTH_SECRET="dev-only-change-me-in-production"
# Signs demo session cookies. DEMO ONLY — not a production credential.
# In any real deployment this must be a cryptographically random 256-bit value
# stored in a secret manager, never in code or chat.
